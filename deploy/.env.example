# Copy to .env (same directory as compose.yaml). `docker compose` reads it automatically.

# Which image to run. GHCR is where the pipeline publishes; the Harbor address is
# the in-network mirror that this LAN host pulls from (see docs/OPERATIONS.md §4).
ACU_IMAGE=ghcr.io/yzh-7/apt-cacher-ultra:latest
# ACU_IMAGE=172.31.0.3:7777/infrastructure/apt-cacher-ultra:1.0.2

# Cache directory. Must be a data disk: entries never expire with the default
# gc.url_path_ttl = "0s". Created and chowned to 113:112 by deploy/prepare.sh.
ACU_CACHE_DIR=/data/harbor/apt-cacher-ultra

# Config generated by deploy/prepare.sh / make-container-config.sh, mounted read-only.
ACU_CONFIG=/etc/apt-cacher-ultra/config.container.toml

ACU_CONTAINER_NAME=apt-cacher-ultra

# Must match the ownership of ACU_CACHE_DIR and the image's USER directive.
ACU_UID=113
ACU_GID=112

# Where the healthcheck probes /healthz. Must match [admin] listen in the config:
# 127.0.0.1:6789 when the status page is loopback-only, 0.0.0.0:6789 when widened.
ACU_ADMIN_PROBE=127.0.0.1:6789

# Set to 1 when generating the container config so adoption is enabled. The
# upstream packaged default ships [adoption] enabled = false, which loads no
# signing keys at all.
ACU_ENABLE_ADOPTION=1
