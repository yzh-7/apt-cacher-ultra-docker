# Copy to /etc/apt-cacher-ultra-docker/harbor-sync.env, chmod 0600, owned by root.
# Everything below is a secret: keep it out of git and out of shell history.
#
# harbor-sync.sh reads this file literally — no shell expansion — and never
# overrides a variable the caller already set in the environment.

HARBOR_REGISTRY=172.31.0.3:7777
HARBOR_PROJECT=infrastructure
IMAGE_NAME=apt-cacher-ultra

# Harbor robot account scoped to this project, with push rights. In the Harbor UI:
# Infrastructure -> Robot Accounts -> Robot Accounts -> Add. The secret is shown
# once at creation; Harbor generates it and ignores any value you try to supply,
# so copy it out of the creation response or reset the robot account.
# A robot can be revoked and expired without touching a human password.
HARBOR_USER=robot$infrastructure+acu-sync
HARBOR_PASSWORD=replace-with-the-robot-secret

GHCR_IMAGE=ghcr.io/yzh-7/apt-cacher-ultra
# Leave GHCR_USER/GHCR_TOKEN unset when the package is public: anonymous pull
# avoids keeping a long-lived GitHub token on the cache server. Set them only for
# a private package, using a fine-grained PAT limited to read:packages — a leaked
# token here can pull images, not push them.
# GHCR_USER=yzh-7
# GHCR_TOKEN=github_pat_xxx

# Tags to mirror: "latest" plus the pinned version in use.
SYNC_TAGS="latest 1.0.2"
