# Copy to /etc/apt-cacher-ultra-docker/harbor-sync.env and chmod 0600 (root:root).
# Everything here is a secret: keep it out of git and out of shell history.

GHCR_IMAGE=ghcr.io/yzh-7/apt-cacher-ultra
GHCR_USER=yzh-7
# Fine-grained PAT that can read packages (read:packages). Read-only: a leaked
# token here can pull images, not push them.
GHCR_TOKEN=github_pat_xxx

HARBOR_REGISTRY=172.31.0.3:7777
HARBOR_PROJECT=infrastructure
# Create in Harbor: Projects -> infrastructure -> Robot Accounts -> "sync-ghcr"
# with "Push images" enabled. Robot accounts can be given an expiry and
# revoked without touching an human password.
HARBOR_USER=robot+infrastructure+sync-ghcr
HARBOR_PASSWORD=xxx

# Tags to mirror. "latest" plus the pinned version in use.
SYNC_TAGS=latest 1.0.2
